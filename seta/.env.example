# ── Telegram ────────────────────────────────────────────────
BOT_TOKEN=123456:PUT_YOUR_TOKEN_HERE
BOT_MODE=polling                 # polling | webhook
WEBHOOK_BASE_URL=               # https://seta.example.uz  (только для webhook)
WEBHOOK_SECRET=change-me-long-random

# ── Первый администратор ────────────────────────────────────
# Ваш Telegram ID. Этот человек получит роль ADMIN при первом /start.
BOOTSTRAP_ADMIN_TELEGRAM_ID=0

# ── Организация ─────────────────────────────────────────────
ORG_NAME=Организация
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_LOCALE=ru

# ── Базы ────────────────────────────────────────────────────
POSTGRES_USER=seta
POSTGRES_PASSWORD=change-me
POSTGRES_DB=seta
DATABASE_URL=postgresql+asyncpg://seta:change-me@postgres:5432/seta
REDIS_URL=redis://redis:6379/0

# ── ИИ (понадобится на блоке 6) ─────────────────────────────
OPENAI_API_KEY=
AI_DAILY_BUDGET_USD=1.0
